<h1><%= t("user_sessions.new.title") %> </h1>

<% if @user_session.errors.has_key? :base %>
  <div id="error_explanation">
    <%= @user_session.errors[:base].join(", ") %>
  </div>
<% end %>

<%= form_with model: @user_session do |f| %>
  <p>
    <%= f.label :email %>
    <%= f.text_field :email %>
    <%= error_tag @user_session, :email %>
  </p>

  <p>
    <%= f.label :password %>
    <%= f.password_field :password %>
    <%= error_tag @user_session, :password %>
  </p>

  <p>
    <%= f.submit %>
  </p>
<% end %>

<p><%= link_to t("user_sessions.new.sign_up"), new_user_path %> </p>
