<% if room.can_review? %>
  <%= form_with model: room.review_route, remote: true do |f| %>
    <div class="review-stars">
      <% room.review_points.reverse_each do |point| %>
        <%= f.radio_button :points, point,
          id: "review_points_#{point}",
          onchange: "this.form.requestSubmit()" %>

        <%= f.label :points, value: point, for: "review_points_#{point}" do %>
          <span aria-hidden="true">★</span>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <span class="login_required">
    <%= t("rooms.review_form.login_to_review") %>
  </span>
<% end %>